{
  "manifest_version": 3,
  "name": "JS Injector",
  "version": "1.0.0",
  "description": "Save multiple JavaScript scripts and inject them into any website on demand.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JS Injector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "activeTab"]
}
